# Shadow node: repo toolchain plus a release build of the replay binary.
# The first build is slow (LLVM-backed WASM engine); later runs reuse the
# cached layers until the source changes.
FROM ubuntu:24.04
RUN apt-get update -y
RUN apt-get install curl -y
RUN curl --proto '=https' --tlsv1.3 -sSf https://sh.rustup.rs | sh -s -- -y
RUN curl -fsSL https://apt.llvm.org/llvm-snapshot.gpg.key | apt-key add - && \
    echo "deb http://apt.llvm.org/noble/ llvm-toolchain-noble-22 main" > /etc/apt/sources.list.d/llvm.list && \
    apt-get update -y
RUN apt-get install -y \
    gcc-13 \
    cmake \
    zlib1g-dev \
    unzip \
    pkg-config \
    llvm-22-dev \
    libpolly-22-dev \
    file \
    curl
ENV PATH="/root/.cargo/bin:${PATH}"
RUN curl -LO https://github.com/protocolbuffers/protobuf/releases/download/v27.1/protoc-27.1-linux-x86_64.zip && \
    unzip protoc-27.1-linux-x86_64.zip -d /usr/local && \
    rm protoc-27.1-linux-x86_64.zip
WORKDIR /src
COPY . /src
RUN cargo build --locked --release --example xpr_blocklog_replay
ENTRYPOINT ["/src/target/release/examples/xpr_blocklog_replay", "/leap-data/blocks", "/arena"]
