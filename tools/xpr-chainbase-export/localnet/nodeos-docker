#!/usr/bin/env bash
# Adapter for export.sh: run Leap's Linux nodeos under Docker while retaining
# the host paths in the command line. The localnet work directory must be
# beneath /tmp so it can be mounted at the same path in the container.
set -euo pipefail

readonly image="${XPR_NODEOS_IMAGE:-pulsevm-xpr-nodeos:leap-5.0.3}"
readonly platform="${XPR_NODEOS_PLATFORM:-linux/amd64}"
docker_args=(
    --rm
    --platform "$platform"
    --network pulsevm-xpr-localnet \
    --mount type=bind,src=/tmp,dst=/tmp
)
if [[ -n "${XPR_NODEOS_HTTP_PORT:-}" ]]; then
    docker_args+=(--publish "127.0.0.1:${XPR_NODEOS_HTTP_PORT}:${XPR_NODEOS_HTTP_PORT}")
fi
exec docker run "${docker_args[@]}" \
    "$image" nodeos "$@"
