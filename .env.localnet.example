# Optional: pass with docker compose --env-file .env.localnet up --build -d.
# Relative bind paths are resolved from the directory containing compose.yaml.
GENESIS_FILE=./genesis.json
HYPERION_SOURCE_DIR=../hyperion-rs
BLOKS_SOURCE_DIR=../bloks-frontend
NODE_COUNT=5

# For the Metal Dollar signed E2E workflow, set the private key matching the
# configured genesis producer. Keep this file private; local testing only.
PULSEVM_PRODUCER_KEY=
PULSEVM_PRODUCER_NAME=pulse
PULSEVM_SYSTEM_ACCOUNT=pulse
PULSEVM_NATIVE_SYSTEM_CONTRACT=true
# Test account private key used only by scripts/setup-webauth-e2e.mjs.
WEBAUTH_PKEY=
# Per-node memory-mapped database capacity, in bytes.
PULSEVM_DB_SIZE=536870912

# Explorer display settings; these do not create a token contract or supply.
CORE_SYMBOL=PULSE
CORE_PRECISION=4

EXPLORER_PORT=8000
HYPERION_PORT=7000
METALGO_HTTP_PORT=9650
SHIP_PORT=9090
RUNNER_GRPC_PORT=8080
RUNNER_HTTP_PORT=8081
ES_JAVA_OPTS="-Xms1g -Xmx1g"
HYPERION_LOG_LEVEL=info
